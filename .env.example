# Copy to .env and fill in. .env is gitignored.
PERCEPTRON_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model per role: perceptron | gemini | claude. Empty *_MODEL = the provider's default
# (perceptron-mk1.5, gemini-3.8-flash, claude-opus-5-5). *_EFFORT: none | low | medium | high.
TRANSCRIBER=perceptron
TRANSCRIBER_MODEL=
TRANSCRIBER_EFFORT=low
ANALYZER=claude
ANALYZER_MODEL=
ANALYZER_EFFORT=medium
# FastAPI browser origins, comma-separated. Add the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set this in Vercel to the public FastAPI URL (for example https://api.example.com).
# NEXT_PUBLIC_BACKEND_URL=https://api.example.com
# Gemini Live prebuilt voice, e.g. Zephyr or Puck
VOICE_NAME=Zephyr
# Silence Gemini waits before marking the candidate's turn complete (milliseconds).
VOICE_SILENCE_MS=500
